{
  "name": "chatfiles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test \"scripts/**/*.test.ts\" \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "audit:chat": "tsx scripts/auditChatIdentity.ts --source work/decrypted/wechat --db data/wechat.next/wechat.db --strict",
    "audit:assets": "tsx scripts/auditConversationAssets.ts --bundle data/chat-assets.current",
    "insights:prepare": "tsx scripts/refreshInsights.ts prepare",
    "insights:distill": "tsx scripts/refreshInsights.ts distill",
    "audit:insights": "tsx scripts/refreshInsights.ts audit",
    "insights:activate": "tsx scripts/refreshInsights.ts activate",
    "dev": "npm run build && tsx server/index.ts",
    "dev:vite": "vite --host 127.0.0.1 --port 3456",
    "ingest:files": "tsx scripts/archiveFiles.ts",
    "ingest:courses": "tsx scripts/fetchCourseData.ts",
    "ingest:discover": "tsx scripts/discoverSources.ts",
    "ingest:deep": "tsx scripts/buildDeepIndex.ts",
    "ingest:databases": "tsx scripts/analyzeDatabases.ts",
    "ingest:binary-text": "tsx scripts/scanBinaryText.ts",
    "ingest:logs": "tsx scripts/scanLogText.ts",
    "ingest:source-text": "tsx scripts/analyzeSourceText.ts",
    "ingest:chat-exports": "tsx scripts/ingestChatExports.ts",
    "ingest:chat-clues": "tsx scripts/buildChatClueDossier.ts",
    "ingest:chat-synthesis": "tsx scripts/buildChatSynthesis.ts",
    "ingest:value-candidates": "tsx scripts/buildValueCandidates.ts",
    "ingest:promote-candidates": "tsx scripts/promoteValueCandidates.ts",
    "ingest:knowledge": "tsx scripts/buildKnowledge.ts",
    "ingest:audit": "tsx scripts/buildCompletionAudit.ts",
    "ingest:summary": "tsx scripts/buildSummary.ts",
    "ingest": "npm run ingest:courses && npm run ingest:discover && npm run ingest:deep && npm run ingest:databases && npm run ingest:binary-text && npm run ingest:logs && npm run ingest:source-text && npm run ingest:files && npm run ingest:chat-exports && npm run ingest:chat-clues && npm run ingest:chat-synthesis && npm run ingest:value-candidates && npm run ingest:promote-candidates && npm run ingest:value-candidates && npm run ingest:knowledge && npm run ingest:audit && npm run ingest:summary",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1 --port 3456",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-typography": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "docx-preview": "^0.3.7",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mime": "^4.1.0",
    "protobufjs": "^7.6.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.0.10",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3-multiple-ciphers": "12.10.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.4"
  }
}
