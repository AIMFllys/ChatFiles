# Copy this file to `.env.local` (gitignored) and fill in YOUR values.
# Nothing personal is committed to the repo; identity is injected locally.

# Owner identity — right-aligns your own chat bubbles in the 聊天 board.
# VITE_OWNER_WXID: a substring of your own wxid (account dir name), e.g. an alias.
# VITE_OWNER_NAME: your display name shown as "我 · <name>".
VITE_OWNER_WXID=
VITE_OWNER_NAME=

# Data-pipeline overrides (optional; only needed when RE-RUNNING the scripts).
# WECHAT_STORE: absolute path to your xwechat_files store if relocated off C:\.
# QQ_NUMBER: your QQ number (the numeric Tencent Files subdirectory).
WECHAT_STORE=
QQ_NUMBER=
